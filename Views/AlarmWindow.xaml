<Window x:Class="SecSeeTime.Views.AlarmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="True"
        Background="#080812"
        Icon="/Assets/icon.ico"
        Title="Sec's See Time — Alarm">

    <Window.Resources>

        <!-- ========================================================= -->
        <!-- ALARM ACTION BUTTON                                        -->
        <!-- ========================================================= -->

        <Style x:Key="AlarmButton"
               TargetType="Button">

            <Setter Property="Background" Value="#1A1526"/>
            <Setter Property="BorderBrush" Value="#4A3D6B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="260"/>
            <Setter Property="Height" Value="76"/>
            <Setter Property="Margin" Value="12,0"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#282039"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#342A4A"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <Style x:Key="AlarmStopButton"
               TargetType="Button"
               BasedOn="{StaticResource AlarmButton}">

            <Setter Property="Background" Value="#3A1220"/>
            <Setter Property="BorderBrush" Value="#8C2A45"/>

        </Style>

    </Window.Resources>


    <!-- ============================================================= -->
    <!-- BACKGROUND                                                     -->
    <!-- ============================================================= -->

    <Grid x:Name="RootGrid">

        <Border Margin="28"
                CornerRadius="30"
                BorderBrush="#5C3A86"
                BorderThickness="1"
                Background="#AA090914"
                x:Name="FrameBorder">

            <Grid Margin="50,34,50,44">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- ROW 0 — BRAND + CYCLE                              -->
                <!-- ================================================= -->

                <Grid Grid.Row="0">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">

                        <Border Width="26"
                                Height="26"
                                CornerRadius="8"
                                ClipToBounds="True">

                            <Border.Background>
                                <ImageBrush ImageSource="/Assets/Images/SST_ProgIcon.png"
                                            Stretch="UniformToFill"/>
                            </Border.Background>

                        </Border>

                        <TextBlock Text="SEC'S SEE TIME"
                                   Foreground="{DynamicResource ThemeAccentLight}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>

                    </StackPanel>

                    <TextBlock x:Name="SourceText"
                               Text="BUILT-IN • CLASSIC ALARM"
                               Foreground="{DynamicResource ThemeTextMuted}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="CycleText"
                               Text="CYCLE 1"
                               Foreground="{DynamicResource ThemeTextMuted}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>

                </Grid>


                <!-- ================================================= -->
                <!-- ROW 1 — CLOCK, STATE, AND THE VIDEO SURFACE        -->
                <!--                                                    -->
                <!-- With no video the whole block centers itself. When -->
                <!-- a YouTube alarm attaches its player, VideoRow is   -->
                <!-- given the remaining space instead.                 -->
                <!-- ================================================= -->

                <Grid x:Name="CenterArea"
                      Grid.Row="1"
                      VerticalAlignment="Center">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="VideoRow" Height="0"/>
                    </Grid.RowDefinitions>


                <StackPanel Grid.Row="0"
                            Margin="0,26,0,0"
                            HorizontalAlignment="Center">

                    <TextBlock x:Name="ClockText"
                               Text="07:00:00 AM"
                               Foreground="{DynamicResource ThemeTextPrimary}"
                               FontFamily="{DynamicResource ThemeClockFontFamily}"
                               FontSize="104"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="AlarmNameText"
                               Text="MORNING ALARM"
                               Foreground="{DynamicResource ThemeTextSecondary}"
                               FontSize="30"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>


                    <!-- Phase badge -->

                    <Border x:Name="PhaseBadge"
                            Margin="0,26,0,0"
                            Padding="26,11"
                            CornerRadius="24"
                            HorizontalAlignment="Center"
                            Background="#1E1330"
                            BorderBrush="#5C3A86"
                            BorderThickness="1">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock x:Name="PhaseIcon"
                                       Text="🔊"
                                       FontSize="20"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>

                            <TextBlock x:Name="PhaseText"
                                       Text="PLAYING"
                                       Foreground="{DynamicResource ThemePlayingAccent}"
                                       FontSize="21"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Border>


                    <TextBlock x:Name="RemainingText"
                               Text="Sound ends in 02:00"
                               Foreground="{DynamicResource ThemeTextSecondary}"
                               FontSize="17"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"/>

                </StackPanel>


                    <!-- YOUTUBE (collapsed for local audio) -->

                    <Border x:Name="VideoHost"
                            Grid.Row="1"
                            Margin="0,24,0,0"
                            MaxWidth="1040"
                            Background="#000000"
                            BorderBrush="#3A3050"
                            BorderThickness="1"
                            Visibility="Collapsed"/>

                </Grid>


                <!-- ================================================= -->
                <!-- ROW 2 — PROGRESS                                   -->
                <!-- ================================================= -->

                <Grid Grid.Row="2"
                      Margin="90,30,90,0">

                    <Border x:Name="ProgressTrack"
                            Height="10"
                            CornerRadius="5"
                            Background="#1E1B2B"
                            SizeChanged="ProgressTrack_SizeChanged">

                        <Border x:Name="ProgressFill"
                                HorizontalAlignment="Left"
                                Width="0"
                                CornerRadius="5"
                                Background="{DynamicResource ThemePlayingAccent}"/>

                    </Border>

                </Grid>


                <!-- ================================================= -->
                <!-- ROW 3 — ACTIONS                                    -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,34,0,0">

                    <Button x:Name="SnoozeButton"
                            Style="{StaticResource AlarmButton}"
                            Click="SnoozeButton_Click">

                        <StackPanel>

                            <TextBlock Text="SNOOZE"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock x:Name="SnoozeDetailText"
                                       Text="5 MINUTES"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemeTextMuted}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                    </Button>


                    <Button x:Name="StopButton"
                            Style="{StaticResource AlarmStopButton}"
                            Click="StopButton_Click">

                        <StackPanel>

                            <TextBlock Text="STOP ALARM"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="ESC"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemeTextMuted}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>
