<Window x:Class="SecSeeTime.Views.AlarmManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alarm Manager • Sec's See Time"
        Icon="/Assets/icon.ico"
        Width="1180"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize">

    <Window.Resources>

        <!-- ========================================================= -->
        <!-- COLORS                                                     -->
        <!-- ========================================================= -->

        <SolidColorBrush x:Key="BackgroundBrush"
                         Color="#090B12"/>

        <SolidColorBrush x:Key="PanelBrush"
                         Color="#111521"/>

        <SolidColorBrush x:Key="PanelLightBrush"
                         Color="#171C29"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#292F42"/>

        <SolidColorBrush x:Key="PrimaryTextBrush"
                         Color="#F4F7FF"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#A2ABBE"/>

        <SolidColorBrush x:Key="MutedTextBrush"
                         Color="#697388"/>

        <SolidColorBrush x:Key="AccentBrush"
                         Color="#8B7CFF"/>

        <SolidColorBrush x:Key="AccentLightBrush"
                         Color="#B3ABFF"/>

        <SolidColorBrush x:Key="GreenBrush"
                         Color="#55D6A7"/>

        <SolidColorBrush x:Key="RedBrush"
                         Color="#FF6685"/>


        <!-- ========================================================= -->
        <!-- SHADOW                                                     -->
        <!-- ========================================================= -->

        <DropShadowEffect x:Key="WindowShadow"
                          BlurRadius="35"
                          ShadowDepth="0"
                          Opacity="0.55"/>


        <!-- ========================================================= -->
        <!-- STANDARD BUTTON                                            -->
        <!-- ========================================================= -->

        <Style x:Key="ActionButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#181E2D"/>

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="18,11"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#232A3C"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#504A86"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#2B3247"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================================================= -->
        <!-- ACCENT BUTTON                                               -->
        <!-- ========================================================= -->

        <Style x:Key="AccentButton"
               TargetType="Button"
               BasedOn="{StaticResource ActionButton}">

            <Setter Property="Background"
                    Value="{StaticResource AccentBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource AccentBrush}"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Padding"
                    Value="24,12"/>

        </Style>


        <!-- ========================================================= -->
        <!-- TEXT BOX                                                    -->
        <!-- ========================================================= -->

        <Style x:Key="DarkTextBox"
               TargetType="TextBox">

            <Setter Property="Background"
                    Value="#0D111B"/>

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="12,9"/>

            <Setter Property="FontSize"
                    Value="12"/>

        </Style>


        <!-- ========================================================= -->
        <!-- COMBO BOX                                                   -->
        <!-- ========================================================= -->

        <Style x:Key="DarkComboBox"
               TargetType="ComboBox">

            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>

            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#111111"/>
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E8E8EE"/>
                                <Setter Property="Foreground" Value="#111111"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DCD8FF"/>
                                <Setter Property="Foreground" Value="#111111"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ========================================================= -->
        <!-- CHECKBOX                                                    -->
        <!-- ========================================================= -->

        <Style x:Key="DayCheckBox"
               TargetType="CheckBox">

            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="Margin"
                    Value="0,0,14,0"/>

        </Style>

    </Window.Resources>


    <!-- ============================================================= -->
    <!-- MAIN WINDOW                                                    -->
    <!-- ============================================================= -->

    <Border Margin="12"
            Background="{StaticResource BackgroundBrush}"
            BorderBrush="#292F42"
            BorderThickness="1"
            CornerRadius="24"
            Effect="{StaticResource WindowShadow}"
            ClipToBounds="True">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="68"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="62"/>

            </Grid.RowDefinitions>


            <!-- ===================================================== -->
            <!-- HEADER                                                  -->
            <!-- ===================================================== -->

            <Border Grid.Row="0"
                    Background="#0C0F18"
                    BorderBrush="#202638"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="24,0,0,0">

                        <Border Width="38"
                                Height="38"
                                CornerRadius="12"
                                Background="{StaticResource AccentBrush}">

                            <TextBlock Text="🔔"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>


                        <StackPanel Margin="13,0,0,0">

                            <TextBlock Text="ALARM MANAGER"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="16"
                                       FontWeight="Bold"/>

                            <TextBlock Text="CREATE • CUSTOMIZE • CONTROL"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0"/>

                        </StackPanel>

                    </StackPanel>


                    <Button Grid.Column="1"
                            Width="42"
                            Height="36"
                            Margin="0,0,18,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            FontSize="22"
                            Cursor="Hand"
                            Click="CloseButton_Click">

                        <TextBlock Text="×"/>

                    </Button>

                </Grid>

            </Border>


            <!-- ===================================================== -->
            <!-- CONTENT                                                 -->
            <!-- ===================================================== -->

            <Grid Grid.Row="1"
                  Margin="24">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="430"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="460"/>
                </Grid.ColumnDefinitions>


                <!-- ================================================= -->
                <!-- LEFT SIDE: ALARM LIST                              -->
                <!-- ================================================= -->

                <Border Grid.Column="0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="18">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>


                        <!-- List header -->

                        <Grid Grid.Row="0"
                              Margin="4,0,4,15">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock Text="YOUR ALARMS"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="14"
                                           FontWeight="Bold"/>

                                <TextBlock x:Name="AlarmSummaryText"
                                           Text="0 alarms configured"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10"
                                           Margin="0,4,0,0"/>

                            </StackPanel>


                            <Button Grid.Column="1"
                                    Style="{StaticResource AccentButton}"
                                    Content="+  NEW ALARM"
                                    Click="NewAlarmButton_Click"/>

                        </Grid>


                        <!-- Alarm list -->

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">

                            <ItemsControl x:Name="AlarmList">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Border Background="#151A27"
                                                BorderBrush="#272E40"
                                                BorderThickness="1"
                                                CornerRadius="15"
                                                Padding="16"
                                                Margin="0,0,0,10">

                                            <Grid>

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="*"/>

                                                    <ColumnDefinition Width="Auto"/>

                                                </Grid.ColumnDefinitions>


                                                <StackPanel>

                                                    <!-- Time -->

                                                    <TextBlock Text="{Binding TimeDisplay}"
                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                               FontFamily="Consolas"
                                                               FontSize="30"
                                                               FontWeight="Bold"/>


                                                    <!-- Name -->

                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Margin="0,4,0,0"/>


                                                    <!-- Repeat -->

                                                    <TextBlock x:Name="RepeatText"
                                                               Text="{Binding RepeatDescription}"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               Margin="0,6,0,0"/>


                                                    <!-- Sound source -->

                                                    <TextBlock Text="{Binding SourceSummary}"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="8"
                                                               FontWeight="SemiBold"
                                                               Opacity="0.75"
                                                               Margin="0,3,0,0"/>

                                                </StackPanel>


                                                <!-- Controls -->

                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center">

                                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                              Tag="{Binding}"
                                                              HorizontalAlignment="Right"
                                                              ToolTip="Enable or disable alarm"
                                                              Click="AlarmEnabled_Click"/>


                                                    <StackPanel Orientation="Horizontal"
                                                                Margin="0,14,0,0">

                                                        <Button Style="{StaticResource ActionButton}"
                                                                Content="EDIT"
                                                                Padding="13,7"
                                                                Tag="{Binding}"
                                                                Click="EditAlarmButton_Click"
                                                                Margin="0,0,6,0"/>

                                                        <Button Style="{StaticResource ActionButton}"
                                                                Content="DELETE"
                                                                Padding="13,7"
                                                                Tag="{Binding}"
                                                                Click="DeleteAlarmButton_Click"/>

                                                    </StackPanel>

                                                </StackPanel>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </ScrollViewer>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- RIGHT SIDE: EDITOR                                  -->
                <!-- ================================================= -->

                <Border Grid.Column="2"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="20">

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,14,0"
                                  CanContentScroll="True">

                        <StackPanel>

                            <!-- Editor title -->

                            <TextBlock x:Name="EditorTitle"
                                       Text="CREATE NEW ALARM"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="15"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Configure exactly how this alarm behaves."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="10"
                                       Margin="0,5,0,20"/>


                            <!-- ================================================= -->
                            <!-- NAME                                                -->
                            <!-- ================================================= -->

                            <TextBlock Text="ALARM NAME"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Margin="0,0,0,7"/>

                            <TextBox x:Name="AlarmNameTextBox"
                                     Style="{StaticResource DarkTextBox}"
                                     HorizontalAlignment="Stretch"
                                     Text="Morning Alarm"/>


                            <!-- ================================================= -->
                            <!-- TIME                                                -->
                            <!-- ================================================= -->

                            <TextBlock Text="TIME"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Margin="0,18,0,7"/>

                            <StackPanel Orientation="Horizontal">

                                <ComboBox x:Name="HourComboBox"
                                          Style="{StaticResource DarkComboBox}"
                                          Width="75"/>

                                <TextBlock Text=":"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="22"
                                           VerticalAlignment="Center"
                                           Margin="7,0"/>

                                <ComboBox x:Name="MinuteComboBox"
                                          Style="{StaticResource DarkComboBox}"
                                          Width="75"/>

                                <ComboBox x:Name="PeriodComboBox"
                                          Style="{StaticResource DarkComboBox}"
                                          Width="75"
                                          Margin="8,0,0,0"/>

                            </StackPanel>


                            <!-- ================================================= -->
                            <!-- REPEAT                                              -->
                            <!-- ================================================= -->

                            <TextBlock Text="REPEAT"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Margin="0,18,0,7"/>

                            <ComboBox x:Name="RepeatComboBox"
                                      HorizontalAlignment="Stretch"
                                      Style="{StaticResource DarkComboBox}"
                                      SelectionChanged="RepeatComboBox_SelectionChanged">

                                <ComboBoxItem Content="Once"/>

                                <ComboBoxItem Content="Daily"/>

                                <ComboBoxItem Content="Weekdays"/>

                                <ComboBoxItem Content="Weekends"/>

                                <ComboBoxItem Content="Custom"/>

                            </ComboBox>


                            <!-- ================================================= -->
                            <!-- CUSTOM DAYS                                         -->
                            <!-- ================================================= -->

                            <StackPanel x:Name="CustomDaysPanel"
                                        Visibility="Collapsed"
                                        Margin="0,12,0,0">

                                <TextBlock Text="CUSTOM DAYS"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Margin="0,0,0,9"/>

                                <WrapPanel>

                                    <CheckBox x:Name="MondayCheckBox"
                                              Content="MON"
                                              Style="{StaticResource DayCheckBox}"/>

                                    <CheckBox x:Name="TuesdayCheckBox"
                                              Content="TUE"
                                              Style="{StaticResource DayCheckBox}"/>

                                    <CheckBox x:Name="WednesdayCheckBox"
                                              Content="WED"
                                              Style="{StaticResource DayCheckBox}"/>

                                    <CheckBox x:Name="ThursdayCheckBox"
                                              Content="THU"
                                              Style="{StaticResource DayCheckBox}"/>

                                    <CheckBox x:Name="FridayCheckBox"
                                              Content="FRI"
                                              Style="{StaticResource DayCheckBox}"/>

                                    <CheckBox x:Name="SaturdayCheckBox"
                                              Content="SAT"
                                              Style="{StaticResource DayCheckBox}"/>

                                    <CheckBox x:Name="SundayCheckBox"
                                              Content="SUN"
                                              Style="{StaticResource DayCheckBox}"/>

                                </WrapPanel>

                            </StackPanel>


                            <!-- ================================================= -->
                            <!-- SOUND SOURCE                                        -->
                            <!-- ================================================= -->

                            <TextBlock Text="ALARM SOUND"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Margin="0,20,0,7"/>

                            <ComboBox x:Name="SoundTypeComboBox"
                                      HorizontalAlignment="Stretch"
                                      Style="{StaticResource DarkComboBox}"
                                      SelectionChanged="SoundTypeComboBox_SelectionChanged">

                                <ComboBoxItem Content="Sound Library"/>

                                <ComboBoxItem Content="My Audio File"/>

                                <ComboBoxItem Content="YouTube"/>

                                <ComboBoxItem Content="Record Audio"/>

                            </ComboBox>


                            <!-- Library sound -->

                            <StackPanel x:Name="BuiltInSoundPanel"
                                        Margin="0,10,0,0">

                                <ComboBox x:Name="BuiltInSoundComboBox"
                                          HorizontalAlignment="Stretch"
                                          Style="{StaticResource DarkComboBox}"
                                          DisplayMemberPath="Name"
                                          SelectionChanged="BuiltInSoundComboBox_SelectionChanged"/>

                                <TextBlock x:Name="SelectedSoundDescription"
                                           Text=""
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="9"
                                           TextWrapping="Wrap"
                                           Margin="2,7,0,0"/>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,10,0,0">

                                    <Button x:Name="PreviewSoundButton"
                                            Style="{StaticResource ActionButton}"
                                            Content="▶  PREVIEW"
                                            Padding="16,8"
                                            Click="PreviewSoundButton_Click"/>

                                    <Button Style="{StaticResource ActionButton}"
                                            Content="BROWSE LIBRARY"
                                            Padding="16,8"
                                            Margin="8,0,0,0"
                                            Click="BrowseLibraryButton_Click"/>

                                </StackPanel>

                            </StackPanel>


                            <!-- Local file -->

                            <StackPanel x:Name="LocalFilePanel"
                                        Visibility="Collapsed"
                                        Margin="0,10,0,0">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>


                                    <TextBox x:Name="LocalAudioPathTextBox"
                                             Style="{StaticResource DarkTextBox}"
                                             IsReadOnly="True"
                                             Text="No audio file selected"/>


                                    <Button Grid.Column="1"
                                            Style="{StaticResource ActionButton}"
                                            Content="BROWSE"
                                            Margin="8,0,0,0"
                                            Click="BrowseAudioButton_Click"/>

                                </Grid>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,10,0,0">

                                    <Button x:Name="PreviewFileButton"
                                            Style="{StaticResource ActionButton}"
                                            Content="▶  PREVIEW"
                                            Padding="16,8"
                                            Click="PreviewFileButton_Click"/>

                                    <Button Style="{StaticResource ActionButton}"
                                            Content="ADD TO LIBRARY"
                                            Padding="16,8"
                                            Margin="8,0,0,0"
                                            ToolTip="Copy this file into Sec's See Time so the alarm keeps working if the original moves"
                                            Click="AddToLibraryButton_Click"/>

                                </StackPanel>

                                <TextBlock x:Name="LocalFormatsText"
                                           Text="MP3 • WAV • M4A • AAC • FLAC • OGG • OPUS • WMA • AIFF"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="8"
                                           Margin="2,8,0,0"/>

                            </StackPanel>


                            <!-- YouTube -->

                            <StackPanel x:Name="YouTubePanel"
                                        Visibility="Collapsed"
                                        Margin="0,10,0,0">

                                <TextBox x:Name="YouTubeUrlTextBox"
                                         Style="{StaticResource DarkTextBox}"
                                         Text="Paste YouTube URL here"/>

                                <TextBlock x:Name="YouTubeOfflineText"
                                           Text="No network connection. YouTube alarms are unavailable."
                                           Foreground="{StaticResource RedBrush}"
                                           FontSize="9"
                                           Visibility="Collapsed"
                                           Margin="2,6,0,0"/>

                                <TextBlock Text="Internet connection required when the alarm plays."
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="8"
                                           Margin="2,6,0,0"/>

                            </StackPanel>


                            <!-- Recorded audio -->

                            <StackPanel x:Name="RecordingPanel"
                                        Visibility="Collapsed"
                                        Margin="0,10,0,0">

                                <Border Padding="12"
                                        CornerRadius="10"
                                        Background="{StaticResource PanelLightBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1">

                                    <StackPanel>

                                        <TextBlock x:Name="RecordingNameText"
                                                   Text="No recording yet"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock x:Name="RecordingDetailText"
                                                   Text="Record a voice memo and this alarm will play it."
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="8"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>

                                    </StackPanel>

                                </Border>


                                <StackPanel Orientation="Horizontal"
                                            Margin="0,10,0,0">

                                    <Button Style="{StaticResource ActionButton}"
                                            Content="●  RECORD"
                                            Padding="16,8"
                                            Click="RecordAudioButton_Click"/>

                                    <Button x:Name="PreviewRecordingButton"
                                            Style="{StaticResource ActionButton}"
                                            Content="▶  PREVIEW"
                                            Padding="16,8"
                                            Margin="8,0,0,0"
                                            Click="PreviewRecordingButton_Click"/>

                                    <Button Style="{StaticResource ActionButton}"
                                            Content="ADD TO LIBRARY"
                                            Padding="16,8"
                                            Margin="8,0,0,0"
                                            ToolTip="Copy this recording into your sound library so other alarms can use it"
                                            Click="AddToLibraryButton_Click"/>

                                </StackPanel>

                            </StackPanel>


                            <!-- ================================================= -->
                            <!-- VOLUME                                              -->
                            <!-- ================================================= -->

                            <TextBlock Text="VOLUME"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Margin="0,20,0,7"/>

                            <Grid>

                                <Slider x:Name="VolumeSlider"
                                        HorizontalAlignment="Stretch"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="100"
                                        TickFrequency="10"
                                        IsSnapToTickEnabled="True"/>

                                <TextBlock x:Name="VolumeValueText"
                                           Text="100%"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="9"
                                           HorizontalAlignment="Right"
                                           Margin="0,22,0,0"/>

                            </Grid>


                            <!-- ================================================= -->
                            <!-- ALARM CYCLE                                         -->
                            <!-- ================================================= -->

                            <TextBlock Text="ALARM CYCLE"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Margin="0,25,0,7"/>

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="12"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <StackPanel>

                                    <TextBlock Text="SOUND FOR"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="8"
                                               Margin="0,0,0,5"/>

                                    <ComboBox x:Name="SoundDurationComboBox"
                                              HorizontalAlignment="Stretch"
                                              Style="{StaticResource DarkComboBox}">

                                        <ComboBoxItem Content="30 seconds"/>

                                        <ComboBoxItem Content="1 minute"/>

                                        <ComboBoxItem Content="2 minutes"/>

                                        <ComboBoxItem Content="3 minutes"/>

                                        <ComboBoxItem Content="5 minutes"/>

                                        <ComboBoxItem Content="10 minutes"/>

                                    </ComboBox>

                                </StackPanel>


                                <StackPanel Grid.Column="2">

                                    <TextBlock Text="SILENCE FOR"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="8"
                                               Margin="0,0,0,5"/>

                                    <ComboBox x:Name="SilenceDurationComboBox"
                                              HorizontalAlignment="Stretch"
                                              Style="{StaticResource DarkComboBox}">

                                        <ComboBoxItem Content="30 seconds"/>

                                        <ComboBoxItem Content="1 minute"/>

                                        <ComboBoxItem Content="2 minutes"/>

                                        <ComboBoxItem Content="3 minutes"/>

                                        <ComboBoxItem Content="5 minutes"/>

                                        <ComboBoxItem Content="10 minutes"/>

                                    </ComboBox>

                                </StackPanel>

                            </Grid>


                            <CheckBox x:Name="RepeatSoundCycleCheckBox"
                                      Content="Repeat sound / silence cycle until dismissed"
                                      Foreground="{StaticResource SecondaryTextBrush}"
                                      FontSize="10"
                                      IsChecked="True"
                                      Margin="0,12,0,0"/>


                            <!-- ================================================= -->
                            <!-- SNOOZE                                              -->
                            <!-- ================================================= -->

                            <TextBlock Text="SNOOZE"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Margin="0,20,0,7"/>

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto"/>

                                    <ColumnDefinition Width="Auto"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <CheckBox x:Name="SnoozeCheckBox"
                                          Content="Enable snooze"
                                          Foreground="{StaticResource SecondaryTextBrush}"
                                          FontSize="10"
                                          IsChecked="True"
                                          VerticalAlignment="Center"/>


                                <ComboBox x:Name="SnoozeComboBox"
                                          Grid.Column="1"
                                          Style="{StaticResource DarkComboBox}"
                                          Width="115"
                                          Margin="15,0,0,0"
                                          SelectionChanged="SnoozeComboBox_SelectionChanged">

                                    <ComboBoxItem Content="1 minute"/>

                                    <ComboBoxItem Content="5 minutes"/>

                                    <ComboBoxItem Content="10 minutes"/>

                                    <ComboBoxItem Content="15 minutes"/>

                                    <ComboBoxItem Content="20 minutes"/>

                                    <ComboBoxItem Content="30 minutes"/>

                                    <ComboBoxItem Content="45 minutes"/>

                                    <ComboBoxItem Content="60 minutes"/>

                                    <ComboBoxItem Content="Custom…"/>

                                </ComboBox>

                            </Grid>


                            <!-- Custom snooze -->

                            <StackPanel x:Name="CustomSnoozePanel"
                                        Orientation="Horizontal"
                                        Visibility="Collapsed"
                                        Margin="0,12,0,0">

                                <TextBlock Text="HOURS"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>

                                <TextBox x:Name="CustomSnoozeHoursTextBox"
                                         Style="{StaticResource DarkTextBox}"
                                         Width="58"
                                         Text="0"/>

                                <TextBlock Text="MINUTES"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="14,0,8,0"/>

                                <TextBox x:Name="CustomSnoozeMinutesTextBox"
                                         Style="{StaticResource DarkTextBox}"
                                         Width="58"
                                         Text="17"/>

                            </StackPanel>


                            <!-- ================================================= -->
                            <!-- SAVE                                                 -->
                            <!-- ================================================= -->

                            <Button x:Name="SaveButton"
                                    Style="{StaticResource AccentButton}"
                                    Content="CREATE ALARM"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,26,0,0"
                                    Click="SaveAlarmButton_Click"/>


                            <Button x:Name="CancelEditButton"
                                    Style="{StaticResource ActionButton}"
                                    Content="CANCEL EDIT"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,8,0,0"
                                    Visibility="Collapsed"
                                    Click="CancelEditButton_Click"/>

                        </StackPanel>

                    </ScrollViewer>

                </Border>

            </Grid>


            <!-- ===================================================== -->
            <!-- FOOTER                                                  -->
            <!-- ===================================================== -->

            <Border Grid.Row="2"
                    Background="#0C0F18"
                    BorderBrush="#202638"
                    BorderThickness="0,1,0,0">

                <Grid Margin="24,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="●"
                                   Foreground="{StaticResource GreenBrush}"
                                   FontSize="8"
                                   VerticalAlignment="Center"
                                   Margin="0,0,7,0"/>

                        <TextBlock Text="ALARM ENGINE RUNNING"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>

                    </StackPanel>


                    <TextBlock Grid.Column="1"
                               Text="SEC'S SEE TIME • ALARM MANAGER"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>