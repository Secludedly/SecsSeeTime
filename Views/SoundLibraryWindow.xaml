<Window x:Class="SecSeeTime.Views.SoundLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sound Library • Sec's See Time"
        Icon="/Assets/icon.ico"
        Width="900"
        Height="640"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False">

    <Window.Resources>

        <!-- ========================================================= -->
        <!-- FLAT ACTION BUTTON                                         -->
        <!-- ========================================================= -->

        <Style x:Key="LibraryButton" TargetType="Button">

            <Setter Property="Background" Value="#181E2D"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemePanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#232A3C"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#504A86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2B3247"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>


        <Style x:Key="LibraryAccentButton"
               TargetType="Button"
               BasedOn="{StaticResource LibraryButton}">
            <Setter Property="Background" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>


        <!-- ========================================================= -->
        <!-- CATEGORY TAB                                               -->
        <!-- ========================================================= -->

        <Style x:Key="CategoryButton" TargetType="Button">

            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,4"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="14,11">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1B2130"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>


    <Border Margin="12"
            Background="{DynamicResource ThemeWindowBackground}"
            BorderBrush="{DynamicResource ThemePanelBorder}"
            BorderThickness="1"
            CornerRadius="22"
            ClipToBounds="True">

        <Border.Effect>
            <DropShadowEffect BlurRadius="35" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="66"/>
            </Grid.RowDefinitions>


            <!-- ===================================================== -->
            <!-- HEADER                                                 -->
            <!-- ===================================================== -->

            <Border Grid.Row="0"
                    Background="#0C0F18"
                    BorderBrush="#202638"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">

                <Grid Margin="24,0">

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Border Width="38"
                                Height="38"
                                CornerRadius="12"
                                Background="{DynamicResource ThemeAccent}">
                            <TextBlock Text="♪"
                                       FontSize="20"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="13,0,0,0">
                            <TextBlock Text="SOUND LIBRARY"
                                       Foreground="{DynamicResource ThemeTextPrimary}"
                                       FontSize="16"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="SubtitleText"
                                       Text="BROWSE • PREVIEW • IMPORT"
                                       Foreground="{DynamicResource ThemeTextMuted}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                    </StackPanel>

                    <Button Width="42"
                            Height="36"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource ThemeTextSecondary}"
                            FontSize="22"
                            Cursor="Hand"
                            Content="×"
                            Click="CloseButton_Click"/>

                </Grid>

            </Border>


            <!-- ===================================================== -->
            <!-- BODY                                                   -->
            <!-- ===================================================== -->

            <Grid Grid.Row="1" Margin="20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- CATEGORIES -->

                <Border Grid.Column="0"
                        Background="{DynamicResource ThemePanelBackground}"
                        BorderBrush="{DynamicResource ThemePanelBorder}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="10">

                    <StackPanel>

                        <TextBlock Text="CATEGORIES"
                                   Foreground="{DynamicResource ThemeTextMuted}"
                                   FontSize="8"
                                   FontWeight="Bold"
                                   Margin="14,8,0,10"/>

                        <ItemsControl x:Name="CategoryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource CategoryButton}"
                                            Tag="{Binding Category}"
                                            Background="{Binding Highlight}"
                                            Foreground="{Binding Foreground}"
                                            Click="CategoryButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Label}"/>
                                            <TextBlock Text="{Binding Count}"
                                                       Opacity="0.55"
                                                       Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>

                </Border>


                <!-- SOUNDS -->

                <Border Grid.Column="2"
                        Background="{DynamicResource ThemePanelBackground}"
                        BorderBrush="{DynamicResource ThemePanelBorder}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="8">

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <ItemsControl x:Name="SoundList">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border Background="#151A27"
                                            BorderBrush="{Binding RowBorder}"
                                            BorderThickness="1"
                                            CornerRadius="13"
                                            Padding="14,12"
                                            Margin="6,5">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>


                                            <!-- Preview -->

                                            <Button Grid.Column="0"
                                                    Style="{StaticResource LibraryButton}"
                                                    Width="44"
                                                    Height="44"
                                                    Padding="0"
                                                    FontSize="15"
                                                    Content="{Binding PreviewGlyph}"
                                                    Tag="{Binding Sound}"
                                                    ToolTip="Preview"
                                                    Click="PreviewButton_Click"/>


                                            <StackPanel Grid.Column="1"
                                                        Margin="14,0,10,0"
                                                        VerticalAlignment="Center">

                                                <TextBlock Text="{Binding Sound.Name}"
                                                           Foreground="{DynamicResource ThemeTextPrimary}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"/>

                                                <TextBlock Text="{Binding Sound.Description}"
                                                           Foreground="{DynamicResource ThemeTextMuted}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,0"/>

                                            </StackPanel>


                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">

                                                <Button Style="{StaticResource LibraryButton}"
                                                        Content="REMOVE"
                                                        Tag="{Binding Sound}"
                                                        Visibility="{Binding RemoveVisibility}"
                                                        Margin="0,0,8,0"
                                                        Click="RemoveButton_Click"/>

                                                <Button Style="{StaticResource LibraryAccentButton}"
                                                        Content="USE"
                                                        Tag="{Binding Sound}"
                                                        Padding="20,8"
                                                        Click="UseButton_Click"/>

                                            </StackPanel>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </Border>

            </Grid>


            <!-- ===================================================== -->
            <!-- FOOTER                                                 -->
            <!-- ===================================================== -->

            <Border Grid.Row="2"
                    Background="#0C0F18"
                    BorderBrush="#202638"
                    BorderThickness="0,1,0,0">

                <Grid Margin="24,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <Button Grid.Column="0"
                            Style="{StaticResource LibraryButton}"
                            Content="+  IMPORT SOUND"
                            VerticalAlignment="Center"
                            Click="ImportButton_Click"/>


                    <TextBlock Grid.Column="1"
                               x:Name="FooterHintText"
                               Foreground="{DynamicResource ThemeTextMuted}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="18,0"
                               TextTrimming="CharacterEllipsis"/>


                    <Button Grid.Column="2"
                            Style="{StaticResource LibraryButton}"
                            Content="CLOSE"
                            VerticalAlignment="Center"
                            Padding="22,8"
                            Click="CloseButton_Click"/>

                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>
