<Window x:Class="SecSeeTime.Views.ThemePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Themes • Sec's See Time"
        Icon="/Assets/icon.ico"
        Width="520"
        Height="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource ThemeWindowBackground}"
            BorderBrush="{DynamicResource ThemePanelBorder}"
            BorderThickness="1"
            CornerRadius="20"
            Margin="10">

        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="62"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- HEADER -->

            <Border Grid.Row="0"
                    Background="{DynamicResource ThemePanelBackground}"
                    CornerRadius="19,19,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">

                <Grid Margin="20,0">

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="THEMES"
                                   Foreground="{DynamicResource ThemeTextPrimary}"
                                   FontSize="14"
                                   FontWeight="Bold"/>

                        <TextBlock Text="APPEARANCE STUDIO • PRESETS"
                                   Foreground="{DynamicResource ThemeTextMuted}"
                                   FontSize="8"
                                   FontWeight="SemiBold"
                                   Margin="0,2,0,0"/>

                    </StackPanel>

                    <Button Content="×"
                            Width="36"
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="20"
                            Cursor="Hand"
                            Foreground="{DynamicResource ThemeTextSecondary}"
                            Click="CloseButton_Click"/>

                </Grid>

            </Border>


            <TextBlock Grid.Row="1"
                       Text="Pick a look. It applies live, including on the alarm screen."
                       Foreground="{DynamicResource ThemeTextMuted}"
                       FontSize="10"
                       Margin="22,16,22,0"
                       TextWrapping="Wrap"/>


            <!-- PRESETS -->

            <ScrollViewer Grid.Row="2"
                          Margin="14,14,14,0"
                          VerticalScrollBarVisibility="Auto">

                <ItemsControl x:Name="PresetList">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Button Tag="{Binding Theme}"
                                    Click="PresetButton_Click"
                                    Cursor="Hand"
                                    Margin="8,6"
                                    HorizontalContentAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Card"
                                                Background="{DynamicResource ThemePanelBackground}"
                                                BorderBrush="{DynamicResource ThemePanelBorder}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Padding="16">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card"
                                                        Property="Background"
                                                        Value="{DynamicResource ThemePanelBackgroundLight}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>


                                    <!-- Swatch -->

                                    <Border Grid.Column="0"
                                            Width="52"
                                            Height="52"
                                            CornerRadius="12"
                                            Background="{Binding Surface}"
                                            BorderBrush="{Binding Accent}"
                                            BorderThickness="2">

                                        <Ellipse Width="18"
                                                 Height="18"
                                                 Fill="{Binding Accent}"/>

                                    </Border>


                                    <StackPanel Grid.Column="1"
                                                Margin="14,0,0,0"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource ThemeTextPrimary}"
                                                   FontSize="13"
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="{DynamicResource ThemeTextMuted}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0"/>

                                    </StackPanel>


                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Marker}"
                                               Foreground="{DynamicResource ThemeSuccess}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>

                                </Grid>

                            </Button>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>


            <!-- FOOTER -->

            <Border Grid.Row="3"
                    Background="{DynamicResource ThemePanelBackground}"
                    CornerRadius="0,0,19,19"
                    Padding="20,14">

                <TextBlock Foreground="{DynamicResource ThemeTextMuted}"
                           FontSize="9"
                           TextWrapping="Wrap"
                           Text="Full font, color, effect and background control arrives with the Appearance Studio in Step 9. These presets run on the same theme engine."/>

            </Border>

        </Grid>

    </Border>

</Window>
