<Window x:Class="SecSeeTime.Views.RecordAudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record Audio • Sec's See Time" Icon="/Assets/icon.ico"
        Width="470" Height="580" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Border Margin="10" CornerRadius="20" Background="{DynamicResource ThemeWindowBackground}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity=".5"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource ThemePanelBackground}" CornerRadius="19,19,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="20,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="RECORD AUDIO" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="SAVED AS A WAV FILE AND ATTACHED TO THE ALARM" Foreground="{DynamicResource ThemeTextMuted}" FontSize="8" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Content="×" Width="34" Height="28" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="18" Click="Cancel_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,20,24,0">

                <!-- Source selection -->

                <TextBlock Text="RECORDING SOURCE" Foreground="{DynamicResource ThemeTextMuted}" FontSize="9" FontWeight="Bold" Margin="2,0,0,5"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="DeviceBox" Padding="9,7" SelectionChanged="DeviceBox_SelectionChanged"
                              ToolTip="Microphones and webcams, plus any playback device captured in loopback"/>

                    <Button x:Name="RefreshDevicesButton" Grid.Column="1" Content="⟳" Width="34" Padding="0,7" Margin="6,0,0,0"
                            ToolTip="Refresh the device list" Click="RefreshDevices_Click"/>
                </Grid>

                <TextBlock x:Name="DeviceHintText" Foreground="{DynamicResource ThemeTextMuted}" FontSize="9"
                           TextWrapping="Wrap" Margin="2,6,0,0"/>

                <Border Padding="16" CornerRadius="14" Margin="0,16,0,0" Background="{DynamicResource ThemePanelBackgroundLight}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="RecordDot" Text="●" Foreground="{DynamicResource ThemeDanger}" FontSize="15" VerticalAlignment="Center" Margin="0,0,9,0" Visibility="Hidden"/>
                            <TextBlock x:Name="ElapsedText" Text="0:00" Foreground="{DynamicResource ThemeTextPrimary}" FontFamily="Consolas" FontSize="38" FontWeight="Bold"/>
                        </StackPanel>

                        <!-- Input level. Confirms the source is live before a
                             mute take gets saved. -->
                        <Border x:Name="MeterTrack" Width="240" Height="7" CornerRadius="4" Margin="0,10,0,0"
                                Background="{DynamicResource ThemePanelBackground}"
                                BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="1">
                            <Border x:Name="MeterFill" HorizontalAlignment="Left" Width="0" CornerRadius="4"
                                    Background="{DynamicResource ThemeSuccess}"/>
                        </Border>

                        <TextBlock x:Name="StatusText" Text="READY" Foreground="{DynamicResource ThemeTextMuted}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button x:Name="RecordButton" Content="●  START RECORDING" Padding="18,9" Click="Record_Click"/>
                    <Button x:Name="PreviewButton" Content="▶  PREVIEW" Padding="18,9" Margin="8,0,0,0" IsEnabled="False" Click="Preview_Click"/>
                </StackPanel>

                <TextBlock Text="RECORDING NAME" Foreground="{DynamicResource ThemeTextMuted}" FontSize="9" FontWeight="Bold" Margin="2,18,0,5"/>
                <TextBox x:Name="NameBox" Padding="9"/>

                <TextBlock x:Name="HintText" Text="Stop the recording to keep it, then use Preview to check it before saving."
                           Foreground="{DynamicResource ThemeTextMuted}" FontSize="9" TextWrapping="Wrap" Margin="2,10,0,0"/>

            </StackPanel>

            <Border Grid.Row="2" Background="{DynamicResource ThemePanelBackground}" CornerRadius="0,0,19,19">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0">
                    <Button x:Name="UseButton" Content="USE RECORDING" Padding="18,8" Margin="6" IsEnabled="False" Click="Use_Click"/>
                    <Button Content="CANCEL" Padding="18,8" Margin="6" Click="Cancel_Click"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
