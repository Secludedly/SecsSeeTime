<Window x:Class="SecSeeTime.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings • Sec's See Time" Icon="/Assets/icon.ico"
        Width="640" Height="660" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">

    <Window.Resources>

        <!-- Section card -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemePanelBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemePanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="SectionCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Margin" Value="0,2,0,14"/>
        </Style>

        <!-- A toggle plus the line of explanation under it -->
        <Style x:Key="OptionToggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="OptionHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="24,3,0,14"/>
        </Style>

    </Window.Resources>

    <Border Margin="10" CornerRadius="22"
            Background="{DynamicResource ThemeWindowBackground}"
            BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity=".5"/>
        </Border.Effect>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="54"/>
            </Grid.RowDefinitions>


            <!-- Header -->

            <Border Grid.Row="0" Background="{DynamicResource ThemePanelBackground}"
                    CornerRadius="21,21,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">

                <Grid Margin="22,0">

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="SETTINGS"
                                   Foreground="{DynamicResource ThemeTextPrimary}"
                                   FontSize="15" FontWeight="Bold"/>

                        <TextBlock Text="WINDOWS INTEGRATION • ALARM BEHAVIOR • DATA"
                                   Foreground="{DynamicResource ThemeTextMuted}"
                                   FontSize="8" Margin="0,2,0,0"/>

                    </StackPanel>

                    <Button Content="×" Width="38" Height="30"
                            HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource ThemeTextSecondary}"
                            FontSize="20" Click="CloseButton_Click"/>

                </Grid>

            </Border>


            <!-- Body -->

            <ScrollViewer Grid.Row="1" Margin="18,18,18,4"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <!-- ============================================= -->
                    <!-- WINDOWS INTEGRATION                            -->
                    <!-- ============================================= -->

                    <Border Style="{StaticResource SettingsCard}">

                        <StackPanel>

                            <TextBlock Text="WINDOWS INTEGRATION"
                                       Style="{StaticResource SectionHeading}"/>

                            <TextBlock Text="HOW SEC'S SEE TIME LIVES ALONGSIDE WINDOWS"
                                       Style="{StaticResource SectionCaption}"/>

                            <CheckBox x:Name="StartWithWindowsBox"
                                      Content="Start with Windows"
                                      Style="{StaticResource OptionToggle}"
                                      Click="Option_Click"/>

                            <TextBlock Style="{StaticResource OptionHint}"
                                       Text="Launches minimized to the tray when you sign in, so alarms are armed without opening the app."/>

                            <CheckBox x:Name="MinimizeToTrayBox"
                                      Content="Minimize to tray"
                                      Style="{StaticResource OptionToggle}"
                                      Click="Option_Click"/>

                            <TextBlock Style="{StaticResource OptionHint}"
                                       Text="Minimizing or closing the window hides it in the notification area and keeps the alarm engine running. Turn this off to make the close button exit the app."/>

                            <CheckBox x:Name="NotificationsBox"
                                      Content="Show Windows notifications"
                                      Style="{StaticResource OptionToggle}"
                                      Click="Option_Click"/>

                            <TextBlock Style="{StaticResource OptionHint}"
                                       Margin="24,3,0,0"
                                       Text="Posts a notification through the tray icon when an alarm starts ringing. The alarm sound and window are unaffected."/>

                            <Button x:Name="TestNotificationButton"
                                    Content="SEND A TEST NOTIFICATION"
                                    HorizontalAlignment="Left"
                                    Padding="14,6" Margin="24,12,0,0"
                                    Click="TestNotification_Click"/>

                        </StackPanel>

                    </Border>


                    <!-- ============================================= -->
                    <!-- CLOCK                                          -->
                    <!-- ============================================= -->

                    <Border Style="{StaticResource SettingsCard}">

                        <StackPanel>

                            <TextBlock Text="CLOCK"
                                       Style="{StaticResource SectionHeading}"/>

                            <TextBlock Text="ONE TIME FORMAT FOR EVERY CLOCK IN THE APP"
                                       Style="{StaticResource SectionCaption}"/>

                            <TextBlock Text="Global time format"
                                       Foreground="{DynamicResource ThemeTextPrimary}"
                                       FontSize="12" FontWeight="SemiBold"/>

                            <TextBlock Style="{StaticResource OptionHint}"
                                       Margin="0,3,0,10"
                                       Text="Applies to the main clock, the World Clock, alarm times, the ringing window, the next-alarm line and the taskbar tooltip."/>

                            <ComboBox x:Name="TimeFormatBox"
                                      Width="280" HorizontalAlignment="Left"
                                      Padding="10,6"
                                      SelectionChanged="TimeFormatBox_SelectionChanged"/>

                            <TextBlock x:Name="TimeFormatHint"
                                       Style="{StaticResource OptionHint}"
                                       Margin="0,10,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- ============================================= -->
                    <!-- ALARM BEHAVIOR                                -->
                    <!-- ============================================= -->

                    <Border Style="{StaticResource SettingsCard}">

                        <StackPanel>

                            <TextBlock Text="ALARM BEHAVIOR"
                                       Style="{StaticResource SectionHeading}"/>

                            <TextBlock Text="WHAT HAPPENS TO ALARMS THE APP WAS NOT AWAKE FOR"
                                       Style="{StaticResource SectionCaption}"/>

                            <TextBlock Text="Missed alarm grace period"
                                       Foreground="{DynamicResource ThemeTextPrimary}"
                                       FontSize="12" FontWeight="SemiBold"/>

                            <TextBlock Style="{StaticResource OptionHint}"
                                       Margin="0,3,0,10"
                                       Text="How late an alarm may be and still fire. This stops a laptop opened at noon from blasting an alarm that was due at seven in the morning."/>

                            <ComboBox x:Name="GraceBox"
                                      Width="240" HorizontalAlignment="Left"
                                      Padding="10,6"
                                      SelectionChanged="GraceBox_SelectionChanged"/>

                        </StackPanel>

                    </Border>


                    <!-- ============================================= -->
                    <!-- DATA                                           -->
                    <!-- ============================================= -->

                    <Border Style="{StaticResource SettingsCard}">

                        <StackPanel>

                            <TextBlock Text="DATA"
                                       Style="{StaticResource SectionHeading}"/>

                            <TextBlock Text="WHERE YOUR ALARMS, THEMES AND PREFERENCES LIVE"
                                       Style="{StaticResource SectionCaption}"/>

                            <Border Background="{DynamicResource ThemePanelBackgroundLight}"
                                    BorderBrush="{DynamicResource ThemePanelBorder}"
                                    BorderThickness="1" CornerRadius="10"
                                    Padding="12" Margin="0,0,0,12">

                                <TextBlock x:Name="DataFolderText"
                                           Foreground="{DynamicResource ThemeTextSecondary}"
                                           FontFamily="Consolas" FontSize="10"
                                           TextWrapping="Wrap"/>

                            </Border>

                            <StackPanel Orientation="Horizontal">

                                <Button Content="OPEN DATA FOLDER"
                                        Padding="14,6" Margin="0,0,10,0"
                                        Click="OpenDataFolder_Click"/>

                                <Button Content="RESET PREFERENCES"
                                        Padding="14,6"
                                        Foreground="{DynamicResource ThemeDanger}"
                                        Click="ResetPreferences_Click"/>

                            </StackPanel>

                            <TextBlock Style="{StaticResource OptionHint}"
                                       Margin="0,10,0,0"
                                       Text="Resetting restores the options on this page to their defaults. Your alarms, saved themes and World Clock cities are left untouched."/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>


            <!-- Footer -->

            <Border Grid.Row="2" Background="{DynamicResource ThemePanelBackground}"
                    CornerRadius="0,0,21,21">

                <Grid Margin="20,0">

                    <TextBlock x:Name="StatusText"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ThemeTextMuted}"
                               FontSize="9"
                               Text="Changes are saved as you make them."/>

                    <Button Content="DONE" HorizontalAlignment="Right"
                            Click="CloseButton_Click" Padding="20,7"/>

                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>
