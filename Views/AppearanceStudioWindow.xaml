<Window x:Class="SecSeeTime.Views.AppearanceStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SecSeeTime.Controls"
        Title="Appearance Studio • Sec's See Time" Icon="/Assets/icon.ico"
        Width="940" Height="720" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Border Margin="10" CornerRadius="22" Background="{DynamicResource ThemeWindowBackground}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity=".5"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="62"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource ThemePanelBackground}" CornerRadius="21,21,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="22,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="APPEARANCE STUDIO" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold"/><TextBlock Text="FULL CLOCK • BACKGROUND • EFFECTS CONTROL" Foreground="{DynamicResource ThemeTextMuted}" FontSize="8" Margin="0,2,0,0"/></StackPanel><Button Content="×" Width="38" Height="30" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="20" Click="CloseButton_Click"/></Grid>
            </Border>
            <Grid Grid.Row="1" Margin="18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="THEMES" Foreground="{DynamicResource ThemeTextMuted}" FontSize="9" FontWeight="Bold" Margin="6,2,0,8"/>
                    <ComboBox x:Name="ThemeCombo" SelectionChanged="ThemeCombo_SelectionChanged" Margin="0,0,0,10"/>
                    <Button Content="LOAD PRESET / SAVED" Click="LoadSelected_Click" Margin="0,0,0,8" Padding="10"/>
                    <Button Content="IMPORT THEME…" Click="Import_Click" Margin="0,0,0,8" Padding="10"/>
                    <Button Content="EXPORT CURRENT…" Click="Export_Click" Margin="0,0,0,18" Padding="10"/>
                    <TextBlock Text="THEME NAME" Foreground="{DynamicResource ThemeTextMuted}" FontSize="9" FontWeight="Bold"/>
                    <TextBox x:Name="ThemeNameBox" TextChanged="ThemeNameBox_TextChanged" Margin="0,5,0,8" Padding="8"/>
                    <TextBlock Text="DESCRIPTION" Foreground="{DynamicResource ThemeTextMuted}" FontSize="9" FontWeight="Bold"/>
                    <TextBox x:Name="ThemeDescriptionBox" TextChanged="ThemeDescriptionBox_TextChanged" Margin="0,5,0,8" Padding="8" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                    <Button Content="SAVE AS CUSTOM" Click="SaveCustom_Click" Margin="0,10,0,8" Padding="10"/>
                    <Button Content="DELETE CURRENT CUSTOM" Click="DeleteCustom_Click" Padding="10"/>
                </StackPanel>
                <TabControl Grid.Column="1" x:Name="EditorTabs">
                    <TabItem Header="CLOCK">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="LIVE PREVIEW" Foreground="{DynamicResource ThemeTextMuted}" FontSize="9" FontWeight="Bold"/>
                            <Border Grid.Row="1" Height="125" Margin="0,8,0,16" CornerRadius="14" Background="{DynamicResource ThemePanelBackgroundLight}"><controls:LetterSpacedTextBlock x:Name="PreviewClock" Text="12:34:56" FontSize="64" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/></Border>
                            <Grid Grid.Row="2" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Text="FONT" VerticalAlignment="Center"/><ComboBox x:Name="FontCombo" Grid.Column="1" SelectionChanged="FontCombo_SelectionChanged"/><TextBlock x:Name="FontSizeValue" Grid.Column="2" Text="104" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                            <Slider Grid.Row="3" x:Name="FontSizeSlider" Minimum="32" Maximum="220" ValueChanged="FontSizeSlider_ValueChanged" Margin="150,0,80,12"/>
                            <Grid Grid.Row="4" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="WEIGHT" VerticalAlignment="Center"/><ComboBox x:Name="WeightCombo" Grid.Column="1" SelectionChanged="WeightCombo_SelectionChanged"><ComboBoxItem Tag="300">Light</ComboBoxItem><ComboBoxItem Tag="400">Normal</ComboBoxItem><ComboBoxItem Tag="500">Medium</ComboBoxItem><ComboBoxItem Tag="600">Semi Bold</ComboBoxItem><ComboBoxItem Tag="700">Bold</ComboBoxItem><ComboBoxItem Tag="800">Extra Bold</ComboBoxItem></ComboBox></Grid>
                            <Grid Grid.Row="5" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="LETTER SPACING" VerticalAlignment="Center"/><Slider Grid.Column="1" x:Name="SpacingSlider" Minimum="0" Maximum="16" ValueChanged="SpacingSlider_ValueChanged"/></Grid>
                            <Grid Grid.Row="6" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="SHOW DATE"/><CheckBox x:Name="ShowDateBox" Grid.Column="1" Click="AppearanceOption_Click"/><TextBlock Grid.Column="2" Text="SHOW SECONDS"/><CheckBox x:Name="ShowSecondsBox" Grid.Column="3" Click="AppearanceOption_Click"/></Grid>
                            <Grid Grid.Row="7" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="24-HOUR CLOCK"/><CheckBox x:Name="Use24Box" Grid.Column="1" Click="AppearanceOption_Click"/><TextBlock Grid.Column="2" Text="ITALIC"/><CheckBox x:Name="ItalicBox" Grid.Column="3" Click="AppearanceOption_Click"/></Grid>
                            <Grid Grid.Row="8" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Text="CLOCK OPACITY" VerticalAlignment="Center"/><Slider Grid.Column="1" x:Name="OpacitySlider" Minimum="0.15" Maximum="1" ValueChanged="OpacitySlider_ValueChanged"/><TextBlock Grid.Column="2" x:Name="OpacityValue" HorizontalAlignment="Right"/></Grid>
                            <Grid Grid.Row="9"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="CLOCK COLOR" VerticalAlignment="Center"/><TextBox x:Name="ClockColorBox" Grid.Column="1" TextChanged="Color_TextChanged" Padding="8"/></Grid>
                        </Grid></ScrollViewer>
                    </TabItem>
                    <TabItem Header="BACKGROUND">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="GRADIENT COLORS (HEX)" Foreground="{DynamicResource ThemeTextMuted}" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="GradientStartBox" TextChanged="Color_TextChanged" Margin="0,0,6,0" Padding="8"/><TextBox x:Name="GradientMidBox" Grid.Column="1" TextChanged="Color_TextChanged" Margin="6,0" Padding="8"/><TextBox x:Name="GradientEndBox" Grid.Column="2" TextChanged="Color_TextChanged" Margin="6,0,0,0" Padding="8"/></Grid>
                            <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="BACKGROUND IMAGE" VerticalAlignment="Center"/><DockPanel Grid.Column="1"><TextBox x:Name="ImagePathBox" TextChanged="ImagePathBox_TextChanged" Padding="8"/><Button Content="BROWSE…" Click="BrowseImage_Click" Margin="8,0,0,0" Padding="12,6"/></DockPanel></Grid>
                            <Grid Grid.Row="3" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="IMAGE OPACITY" VerticalAlignment="Center"/><Slider Grid.Column="1" x:Name="ImageOpacitySlider" Minimum="0" Maximum="1" ValueChanged="ImageOpacitySlider_ValueChanged"/><TextBlock Grid.Column="2" x:Name="ImageOpacityValue" HorizontalAlignment="Right"/></Grid>
                            <Grid Grid.Row="4" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="IMAGE FIT" VerticalAlignment="Center"/><ComboBox x:Name="ImageStretchCombo" Grid.Column="1" SelectionChanged="ImageStretchCombo_SelectionChanged"><ComboBoxItem>UniformToFill</ComboBoxItem><ComboBoxItem>Uniform</ComboBoxItem><ComboBoxItem>Fill</ComboBoxItem><ComboBoxItem>None</ComboBoxItem></ComboBox></Grid>
                            <TextBlock Grid.Row="5" Text="OVERLAY COLOR (HEX)" Foreground="{DynamicResource ThemeTextMuted}" FontSize="9" FontWeight="Bold" Margin="0,6,0,5"/><Grid Grid.Row="6" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBox x:Name="OverlayColorBox" TextChanged="Color_TextChanged" Padding="8"/><Slider Grid.Column="1" x:Name="OverlaySlider" Minimum="0" Maximum="1" ValueChanged="OverlaySlider_ValueChanged" Margin="10,0"/><TextBlock Grid.Column="2" x:Name="OverlayValue" HorizontalAlignment="Right"/></Grid>
                            <Grid Grid.Row="7" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="DARKNESS / OVERLAY" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Use the overlay to make a photo darker without editing the image itself." Foreground="{DynamicResource ThemeTextMuted}" TextWrapping="Wrap"/></Grid>
                            <TextBlock Grid.Row="8" Text="Tip: the image path is stored as a local path, so keep the image in a permanent location." Foreground="{DynamicResource ThemeTextMuted}" FontSize="9" TextWrapping="Wrap"/>
                        </Grid></ScrollViewer>
                    </TabItem>
                    <TabItem Header="PALETTE">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="WINDOW" VerticalAlignment="Center"/><TextBox x:Name="WindowColorBox" Grid.Row="0" Grid.Column="1" TextChanged="Color_TextChanged" Padding="8" Margin="6"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="PANEL" VerticalAlignment="Center"/><TextBox x:Name="PanelColorBox" Grid.Row="0" Grid.Column="3" TextChanged="Color_TextChanged" Padding="8" Margin="6"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="PANEL LIGHT" VerticalAlignment="Center"/><TextBox x:Name="PanelLightColorBox" Grid.Row="1" Grid.Column="1" TextChanged="Color_TextChanged" Padding="8" Margin="6"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="PANEL BORDER" VerticalAlignment="Center"/><TextBox x:Name="PanelBorderColorBox" Grid.Row="1" Grid.Column="3" TextChanged="Color_TextChanged" Padding="8" Margin="6"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="TEXT SECONDARY" VerticalAlignment="Center"/><TextBox x:Name="TextSecondaryColorBox" Grid.Row="2" Grid.Column="1" TextChanged="Color_TextChanged" Padding="8" Margin="6"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="TEXT MUTED" VerticalAlignment="Center"/><TextBox x:Name="TextMutedColorBox" Grid.Row="2" Grid.Column="3" TextChanged="Color_TextChanged" Padding="8" Margin="6"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="ACCENT" VerticalAlignment="Center"/><TextBox x:Name="AccentColorBox" Grid.Row="3" Grid.Column="1" TextChanged="Color_TextChanged" Padding="8" Margin="6"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="ACCENT LIGHT" VerticalAlignment="Center"/><TextBox x:Name="AccentLightColorBox" Grid.Row="3" Grid.Column="3" TextChanged="Color_TextChanged" Padding="8" Margin="6"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="SUCCESS" VerticalAlignment="Center"/><TextBox x:Name="SuccessColorBox" Grid.Row="4" Grid.Column="1" TextChanged="Color_TextChanged" Padding="8" Margin="6"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="DANGER" VerticalAlignment="Center"/><TextBox x:Name="DangerColorBox" Grid.Row="4" Grid.Column="3" TextChanged="Color_TextChanged" Padding="8" Margin="6"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="PLAYING ACCENT" VerticalAlignment="Center"/><TextBox x:Name="PlayingColorBox" Grid.Row="5" Grid.Column="1" TextChanged="Color_TextChanged" Padding="8" Margin="6"/>
                            <TextBlock Grid.Row="5" Grid.Column="2" Text="SILENCE ACCENT" VerticalAlignment="Center"/><TextBox x:Name="SilenceColorBox" Grid.Row="5" Grid.Column="3" TextChanged="Color_TextChanged" Padding="8" Margin="6"/>
                        </Grid></ScrollViewer>
                    </TabItem>
                    <TabItem Header="EFFECTS">
                        <StackPanel Margin="18">
                            <TextBlock Text="CLOCK GLOW" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMuted}" FontSize="9"/>
                            <CheckBox x:Name="GlowBox" Content="Enable glow" Margin="0,8,0,8" Click="AppearanceOption_Click"/>
                            <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="GLOW STRENGTH" VerticalAlignment="Center"/><Slider Grid.Column="1" x:Name="GlowSlider" Minimum="0" Maximum="1" ValueChanged="GlowSlider_ValueChanged"/><TextBlock Grid.Column="2" x:Name="GlowValue" HorizontalAlignment="Right"/></Grid>
                            <TextBlock Text="OUTLINE" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMuted}" FontSize="9"/><CheckBox x:Name="OutlineBox" Content="Enable clock outline" Margin="0,8" Click="AppearanceOption_Click"/>
                            <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock Text="OUTLINE THICKNESS" VerticalAlignment="Center"/><Slider Grid.Column="1" x:Name="OutlineSlider" Minimum="0.5" Maximum="4" ValueChanged="OutlineSlider_ValueChanged"/><TextBlock Grid.Column="2" x:Name="OutlineValue" HorizontalAlignment="Right"/></Grid>
                            <TextBox x:Name="OutlineColorBox" TextChanged="Color_TextChanged" Padding="8" Margin="0,0,0,18"/>
                            <TextBlock Text="AMBIENT EFFECTS" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMuted}" FontSize="9"/><CheckBox x:Name="ParticlesBox" Content="Floating particles" Margin="0,8" Click="AppearanceOption_Click"/><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="PARTICLE COUNT" VerticalAlignment="Center"/><Slider Grid.Column="1" x:Name="ParticleSlider" Minimum="0" Maximum="150" ValueChanged="ParticleSlider_ValueChanged"/><TextBlock Grid.Column="2" x:Name="ParticleValue" HorizontalAlignment="Right"/></Grid><CheckBox x:Name="ScanlinesBox" Content="Retro scanlines" Margin="0,8" Click="AppearanceOption_Click"/><CheckBox x:Name="NoiseBox" Content="Subtle film/noise effect" Margin="0,8" Click="AppearanceOption_Click"/><TextBlock Text="Scanlines/noise are intentionally subtle so the clock remains readable." Foreground="{DynamicResource ThemeTextMuted}" FontSize="9" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="WORLD CLOCK">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
                            <TextBlock Text="SECONDARY CLOCKS ON THE MAIN WINDOW" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMuted}" FontSize="9"/>
                            <TextBlock Text="Cities are added in the World Clock window. These settings control how the rail beside the main clock presents them; its colors follow the PALETTE tab." Foreground="{DynamicResource ThemeTextMuted}" FontSize="9" TextWrapping="Wrap" Margin="0,6,0,12"/>
                            <CheckBox x:Name="WorldClockShowBox" Content="Show world clocks beside the main clock" Margin="0,0,0,8" Click="AppearanceOption_Click"/>
                            <CheckBox x:Name="WorldClockLeftBox" Content="Place the rail on the left instead of the right" Margin="0,0,0,8" Click="AppearanceOption_Click"/>
                            <CheckBox x:Name="WorldClockDateBox" Content="Show each city's date" Margin="0,0,0,8" Click="AppearanceOption_Click"/>
                            <CheckBox x:Name="WorldClockZoneBox" Content="Show the DST / UTC offset line" Margin="0,0,0,8" Click="AppearanceOption_Click"/>
                            <CheckBox x:Name="WorldClockFontBox" Content="Use the clock font instead of Consolas" Margin="0,0,0,16" Click="AppearanceOption_Click"/>
                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="TIME SIZE" VerticalAlignment="Center"/><Slider Grid.Column="1" x:Name="WorldClockSizeSlider" Minimum="12" Maximum="48" ValueChanged="WorldClockSizeSlider_ValueChanged"/><TextBlock Grid.Column="2" x:Name="WorldClockSizeValue" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="RAIL OPACITY" VerticalAlignment="Center"/><Slider Grid.Column="1" x:Name="WorldClockOpacitySlider" Minimum="0.2" Maximum="1" ValueChanged="WorldClockOpacitySlider_ValueChanged"/><TextBlock Grid.Column="2" x:Name="WorldClockOpacityValue" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                        </StackPanel></ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
            <Border Grid.Row="2" Background="{DynamicResource ThemePanelBackground}" CornerRadius="0,0,21,21"><Grid Margin="20,0"><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextMuted}" FontSize="9"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="APPLY" Click="Apply_Click" Padding="18,8" Margin="6"/><Button Content="SAVE" Click="SaveCustom_Click" Padding="18,8" Margin="6"/><Button Content="CLOSE" Click="CloseButton_Click" Padding="18,8" Margin="6"/></StackPanel></Grid></Border>
        </Grid>
    </Border>
</Window>
