<Window x:Class="SecSeeTime.Views.WorldClockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="World Clock • Sec's See Time" Icon="/Assets/icon.ico"
        Width="920" Height="650" MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Border Margin="10" CornerRadius="22" Background="{DynamicResource ThemeWindowBackground}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity=".5"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="54"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource ThemePanelBackground}" CornerRadius="21,21,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown"><Grid Margin="22,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="WORLD CLOCK" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold"/><TextBlock Text="MULTIPLE CITIES • LIVE DST-AWARE TIME" Foreground="{DynamicResource ThemeTextMuted}" FontSize="8" Margin="0,2,0,0"/></StackPanel><Button Content="×" Width="38" Height="30" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="20" Click="CloseButton_Click"/></Grid></Border>
            <Grid Grid.Row="1" Margin="18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource ThemePanelBackground}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,12,0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="SearchBox" Grid.Row="0" TextChanged="SearchBox_TextChanged" Padding="10" Margin="0,0,0,10" ToolTip="Search city, country, or time zone ID"/><ListBox x:Name="ZoneList" Grid.Row="1"/><Button Grid.Row="2" Content="ADD SELECTED CITY" Click="Add_Click" Padding="12" Margin="0,10,0,0"/></Grid>
                </Border>
                <Border Grid.Column="1" Background="{DynamicResource ThemePanelBackground}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="1" CornerRadius="16" Padding="16">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="YOUR CLOCKS" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="13" FontWeight="Bold"/><TextBlock x:Name="CountText" HorizontalAlignment="Right" Foreground="{DynamicResource ThemeTextMuted}" FontSize="9" VerticalAlignment="Center"/></Grid><ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="ClockList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource ThemePanelBackgroundLight}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" FontWeight="Bold"/><TextBlock Text="{Binding TimeZoneId}" Foreground="{DynamicResource ThemeTextMuted}" FontSize="8" Margin="0,2,0,8"/><TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource ThemeAccentLight}" FontSize="30" FontFamily="Consolas" FontWeight="Bold"/><TextBlock Text="{Binding DateText}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13" FontWeight="Medium" Margin="0,4,0,0"/><TextBlock Text="{Binding MetaText}" Foreground="{DynamicResource ThemeTextMuted}" FontSize="9" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="★" Tag="{Binding}" Click="Favorite_Click" Width="34" Height="30" Margin="0,0,0,5"/><Button Content="↑" Tag="{Binding}" Click="Up_Click" Width="34" Height="28" Margin="0,0,0,5"/><Button Content="↓" Tag="{Binding}" Click="Down_Click" Width="34" Height="28" Margin="0,0,0,5"/><Button Content="×" Tag="{Binding}" Click="Remove_Click" Width="34" Height="28"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid>
                </Border>
            </Grid>
            <Border Grid.Row="2" Background="{DynamicResource ThemePanelBackground}" CornerRadius="0,0,21,21"><Grid Margin="20,0"><TextBlock Text="DST is handled by Windows TimeZoneInfo; no manual daylight-saving offsets are stored." VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextMuted}" FontSize="9"/><Button Content="DONE" HorizontalAlignment="Right" Click="CloseButton_Click" Padding="20,7"/></Grid></Border>
        </Grid>
    </Border>
</Window>
